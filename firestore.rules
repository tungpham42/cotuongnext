rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // All game state is written by the server (Firebase Admin) only.
    match /users/{u}   { allow read: if true; allow write: if false; }
    match /rooms/{r}   {
      allow read: if request.auth != null; allow write: if false;
      match /messages/{m} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() < 300;
      }
    }
    match /rooms_private/{r} { allow read, write: if false; }
  }
}
