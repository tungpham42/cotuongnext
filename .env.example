# Canonical public URL used by metadata, sitemap.xml, and robots.txt.
# Change this when deploying to a different domain.
NEXT_PUBLIC_SITE_URL=https://cotuong.top
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# ---- Firebase web app (Firebase console → Project settings → General → Your apps) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase Admin (Project settings → Service accounts → Generate new private key) ----
# Copy these three values from the downloaded JSON file.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes and the literal \n sequences exactly as they appear in the JSON.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n\n-----END PRIVATE KEY-----\n"

SECRETS_SCAN_ENABLED="false"
